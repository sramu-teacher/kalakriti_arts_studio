# URL of the deployed Google Apps Script Web App (ends in /exec).
# See google-apps-script/README.md for deployment steps.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# OAuth Client ID for Google sign-in on /admin (Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID → Web application).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The owner's Google account email — only this address can access /admin.
# Must match the OWNER_EMAIL constant in google-apps-script/Code.gs.
VITE_ADMIN_EMAIL=kalakritiarts.studio@gmail.com

# WhatsApp number the floating button links to (country code, no + or spaces).
VITE_WHATSAPP_NUMBER=917022474888
